# Backend environment
APP_NAME=VQA Dataset Annotation Platform
ENVIRONMENT=development
# Obtain this PostgreSQL URI from Supabase Dashboard > Connect (Direct or Session Pooler).
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
GOOGLE_CLIENT_ID=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
# Local-only option when organization policy permits service-account keys. Leave empty on Render.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Per-user Google Drive OAuth Web Application credentials.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=
# Legacy dedicated-account fallback. New user-facing Drive operations do not use this token.
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ACCOUNT_EMAIL=
MAX_PDF_SIZE_MB=50
# Backend-only Gemini configuration. Never put this key in frontend/.env or source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
